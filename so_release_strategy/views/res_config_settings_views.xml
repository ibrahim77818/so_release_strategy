<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_so_release" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.so.release</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Release Strategies" name="so_release_setting_container">
                    <setting id="so_release_strategy" company_dependent="1"
                             help="Require the approval of the sales team release strategy before confirming sales orders">
                        <field name="so_release_strategy_enabled"/>
                        <div class="content-group">
                            <div class="text-muted mt8">
                                Each sales team must have a default release strategy. Quotations are evaluated against
                                the strategy of their team; sales team and salesperson become mandatory and the team must
                                be one the salesperson belongs to.
                            </div>
                            <div class="text-muted mt8">
                                Switching it off cancels the approvals still pending; the approval history is kept.
                            </div>
                            <div class="mt8">
                                <button name="%(so_release_strategy.action_so_release_strategy)d" type="action"
                                        string="Release Strategies" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                            <div>
                                <button name="%(sales_team.crm_team_action_config)d" type="action"
                                        string="Sales Teams" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
