<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="so_release_action_wizard_view_form" model="ir.ui.view">
        <field name="name">so.release.action.wizard.form</field>
        <field name="model">so.release.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Release Action">
                <field name="action" invisible="1"/>
                <field name="notes_required" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-warning o_so_release_alert" role="alert"
                     invisible="action != 'bypass'">
                    The remaining approval stages will be skipped and the post-approval action applied immediately.
                </div>
                <div class="alert alert-info o_so_release_alert" role="alert"
                     invisible="action != 'reset'">
                    All approvals will be cleared and the order will need to be submitted again.
                </div>
                <group>
                    <field name="order_id"/>
                    <field name="release_amount_company"/>
                    <field name="role_names" invisible="not role_names"/>
                    <field name="notes" placeholder="Add your comments..."
                           required="notes_required"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Approve" class="btn-primary"
                            invisible="action != 'approve'" data-hotkey="q"/>
                    <button name="action_confirm" type="object" string="Reject" class="btn-danger"
                            invisible="action != 'reject'" data-hotkey="q"/>
                    <button name="action_confirm" type="object" string="Bypass Approval" class="btn-primary"
                            invisible="action != 'bypass'" data-hotkey="q"/>
                    <button name="action_confirm" type="object" string="Reset" class="btn-primary"
                            invisible="action != 'reset'" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
