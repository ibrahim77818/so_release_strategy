<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_so_release" model="ir.module.category">
        <field name="name">Sales Release Strategy</field>
        <field name="parent_id" ref="base.module_category_sales"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_so_release_supervisor" model="res.groups">
        <field name="name">Release Supervisor</field>
        <field name="category_id" ref="module_category_so_release"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can bypass and reset sales order release strategies.</field>
    </record>

    <!-- Approvers who only see their own documents can still open the orders
         they have to approve (read only; approvals are written in sudo). These
         rules are OR-ed with the native "Personal Orders" rules. -->
    <record id="sale_order_release_approver_rule" model="ir.rule">
        <field name="name">Sales release: orders to approve</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">['|', ('release_line_ids.user_id', '=', user.id), ('release_line_ids.group_id.users', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="sale_order_line_release_approver_rule" model="ir.rule">
        <field name="name">Sales release: order lines to approve</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">['|', ('order_id.release_line_ids.user_id', '=', user.id), ('order_id.release_line_ids.group_id.users', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <data noupdate="1">
        <record id="so_release_strategy_company_rule" model="ir.rule">
            <field name="name">Sales release strategy: multi-company</field>
            <field name="model_id" ref="model_so_release_strategy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="so_release_strategy_rule_company_rule" model="ir.rule">
            <field name="name">Sales release strategy rule: multi-company</field>
            <field name="model_id" ref="model_so_release_strategy_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="so_release_line_company_rule" model="ir.rule">
            <field name="name">Sales release approval: multi-company</field>
            <field name="model_id" ref="model_sale_order_release_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
